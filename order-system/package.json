{
  "name": "buschmann-order-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "B2B-Vorbestellsystem für Buschmann 1846 — Cloudflare Worker + D1",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file=seeds/001_placeholder.sql"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.125.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260820.1": true
  }
}
