{
  "compilerOptions": {
    /* Cloudflare Workers ist eine moderne ES-Module-Umgebung — kein Bundler-
       Downlevel, kein CommonJS, keine DOM-Typen. */
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types"],

    /* Die Anforderung aus Abschnitt 7: strikt, und zwar vollständig. */
    "strict": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* Der Worker wird von Wrangler gebündelt, tsc prüft nur. */
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "*.ts", "worker-configuration.d.ts"],
  "exclude": ["node_modules"]
}
